{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map. Each circle is a council. The circle's area is the number of war memorials in that council. Circles sit at the average position of the council's memorials.",
  "width": "container",
  "height": 560,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [-14, -25],
    "rotate": [-146, 0]
  },
  "layer": [
    {
      "data": {
        "url": "data/qld_councils.json",
        "format": {
          "type": "topojson",
          "feature": "qld_lga"
        }
      },
      "mark": {"type": "geoshape", "fill": "#e9e4d6", "stroke": "#fbf9f4", "strokeWidth": 0.6}
    },
    {
      "data": {"url": "data/qld_memorials.csv"},
      "transform": [
        {
          "calculate": "lower(toString(datum.coords_ok)) == 'true' ? datum.latitude : null",
          "as": "good_lat"
        },
        {
          "calculate": "lower(toString(datum.coords_ok)) == 'true' ? datum.longitude : null",
          "as": "good_lon"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "memorials"
            },
            {
              "op": "mean",
              "field": "good_lat",
              "as": "lat"
            },
            {
              "op": "mean",
              "field": "good_lon",
              "as": "lon"
            }
          ],
          "groupby": [
            "lga_name"
          ]
        },
        {
          "calculate": "datum.lga_name + ': ' + datum.memorials",
          "as": "label"
        }
      ],
      "layer": [
        {
          "mark": {"type": "circle", "fill": "#b8281c", "fillOpacity": 0.55, "stroke": "#7e1a12", "strokeWidth": 0.8},
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "memorials",
              "type": "quantitative",
              "scale": {
                "zero": true,
                "range": [10, 2600]
              },
              "legend": {
                "title": [
                  "Memorials",
                  "in the council"
                ],
                "orient": "top-right",
                "values": [10, 50, 100, 250],
                "symbolFillColor": "#b8281c",
                "symbolOpacity": 0.55
              }
            },
            "order": {
              "field": "memorials",
              "type": "quantitative",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "lga_name",
                "type": "nominal",
                "title": "Council"
              },
              {
                "field": "memorials",
                "type": "quantitative",
                "title": "Memorials"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lga_name == 'Brisbane'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#2b2a27",
            "align": "center",
            "baseline": "top",
            "dy": 24
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lga_name == 'Toowoomba'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#2b2a27",
            "align": "right",
            "baseline": "middle",
            "dx": -24
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.lga_name == 'Sunshine Coast' || datum.lga_name == 'Bundaberg'"
            }
          ],
          "mark": {
            "type": "text",
            "fontSize": 12,
            "fontWeight": 700,
            "color": "#2b2a27",
            "align": "center",
            "baseline": "bottom",
            "dy": -20
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
