{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of memorial types against the wars they honour in Queensland. Each column adds up to 100 per cent, so wars of different sizes can be compared. Types that never reach 5 per cent of any war are grouped as Other types.",
  "width": "container",
  "height": {"step": 30},
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {"top": 118, "left": 60, "right": 52, "bottom": 4},
  "data": {"url": "data/qld_memorials.csv"},
  "transform": [
    {
      "calculate": "split(datum.conflicts || '', '|')",
      "as": "tags"
    },
    {
      "flatten": ["tags"]
    },
    {"calculate": "trim(split(datum.tags, ',')[0])", "as": "tag"},
    {
      "filter": "indexof(['Unit memorials', 'Other', 'Japan (BCOF)', ''], datum.tag) < 0"
    },
    {
      "calculate": "datum.tag == 'South Africa War' ? 'Boer War' : datum.tag",
      "as": "war"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "memorials"
        }
      ],
      "groupby": [
        "type_main",
        "war"
      ]
    },
    {
      "joinaggregate": [
        {"op": "sum", "field": "memorials", "as": "war_total"}
      ],
      "groupby": ["war"]
    },
    {"filter": "datum.war_total >= 50"},
    {
      "calculate": "datum.memorials / datum.war_total * 100",
      "as": "percent"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "percent", "as": "type_max"}
      ],
      "groupby": ["type_main"]
    },
    {
      "calculate": "datum.type_max < 5 ? 'Other types' : datum.type_main",
      "as": "type"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "memorials", "as": "memorials"}
      ],
      "groupby": ["type", "war"]
    },
    {
      "impute": "memorials",
      "key": "war",
      "groupby": ["type"],
      "value": 0
    },
    {
      "joinaggregate": [
        {"op": "sum", "field": "memorials", "as": "war_total"}
      ],
      "groupby": ["war"]
    },
    {
      "joinaggregate": [
        {"op": "sum", "field": "memorials", "as": "type_total"}
      ],
      "groupby": ["type"]
    },
    {
      "calculate": "datum.memorials / datum.war_total * 100",
      "as": "percent"
    },
    {
      "calculate": "datum.type == 'Other types' ? -1 : datum.type_total",
      "as": "row_order"
    },
    {
      "calculate": "datum.percent < 1 ? '0–1%' : datum.percent < 5 ? '1–5%' : datum.percent < 10 ? '5–10%' : datum.percent < 20 ? '10–20%' : datum.percent < 35 ? '20–35%' : '35% or more'",
      "as": "band"
    }
  ],
  "encoding": {
    "x": {
      "field": "war",
      "type": "ordinal",
      "title": null,
      "sort": [
        "Boer War",
        "First World War",
        "Second World War",
        "Malayan Emergency",
        "Korean War",
        "Indonesian Confrontation",
        "Vietnam War",
        "Peacekeeping",
        "Gulf War",
        "Somalia"
      ],
      "axis": {
        "orient": "top",
        "labelAngle": -35,
        "labelAlign": "left",
        "labelFontWeight": 600,
        "domain": false,
        "ticks": false,
        "labelLimit": 220
      }
    },
    "y": {
      "field": "type",
      "type": "ordinal",
      "title": null,
      "sort": {
        "field": "row_order",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 200
      }
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#fbf9f4", "strokeWidth": 1.5},
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "scale": {
            "domain": ["0–1%", "1–5%", "5–10%", "10–20%", "20–35%", "35% or more"],
            "range": ["#eee9dc", "#efd5bd", "#d99a80", "#c4604a", "#a32a1c", "#5e0f08"]
          },
          "legend": {
            "title": "Share of the war's memorials",
            "titleLimit": 320,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 3,
            "symbolType": "square",
            "symbolSize": 200,
            "columnPadding": 18,
            "rowPadding": 6
          }
        },
        "tooltip": [
          {
            "field": "type",
            "type": "nominal",
            "title": "Memorial type"
          },
          {
            "field": "war",
            "type": "nominal",
            "title": "War"
          },
          {
            "field": "memorials",
            "type": "quantitative",
            "title": "Memorials"
          },
          {
            "field": "war_total",
            "type": "quantitative",
            "title": "All memorials honouring the war"
          },
          {
            "field": "percent",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14
      },
      "encoding": {
        "text": {
          "condition": {
            "test": "datum.percent >= 5",
            "field": "percent",
            "type": "quantitative",
            "format": ".0f"
          },
          "value": ""
        },
        "color": {
          "condition": {
            "test": "datum.percent >= 10",
            "value": "#ffffff"
          },
          "value": "#2b2a27"
        }
      }
    },
    {
      "mark": {"type": "rect", "fill": null, "stroke": "#2b2a27", "strokeWidth": 2.5},
      "encoding": {
        "strokeOpacity": {
          "condition": {
            "test": "indexof(['First World War|Honour board', 'Vietnam War|Honour board', 'First World War|Stone/cairn/plinth', 'Vietnam War|Stone/cairn/plinth', 'Malayan Emergency|Stone/cairn/plinth'], datum.war + '|' + datum.type) >= 0",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null}
  }
}
