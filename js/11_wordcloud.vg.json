{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Word cloud of the words engraved on Queensland war memorials, showing words used 36 times or more. Larger words are used more often. Red words are named in the headline; dark words come from three set phrases; editors' notes in square brackets and common little words are removed.",
  "width": 1000,
  "height": 330,
  "padding": 12,
  "autosize": "pad",
  "data": [
    {
      "name": "words",
      "url": "data/qld_memorials.csv",
      "format": {"type": "csv"},
      "transform": [
        {
          "type": "formula",
          "expr": "replace(replace(datum.inscription || '', /\\[[^\\]]*\\]/g, ' '), /\\([^)]*\\)/g, ' ')",
          "as": "clean"
        },
        {
          "type": "countpattern",
          "field": "clean",
          "case": "lower",
          "pattern": "[a-z']{3,}",
          "stopwords": "^(the|and|for|that|this|with|who|are|was|were|from|have|has|had|they|their|them|our|his|her|its|been|will|not|but|all|you|your|than|whose|which|when|where|these|those|then|there|also|can|may|shall|any|out|into|per|each|both|upon|about|such|only|other|him|she|too|one|two|three|names?|refer|images?|additional|confirmed|reads?|listed|list|plaques?|inscriptions?|page|panel|text|above|below|left|right|side|front|back|top|bottom|reverse|small|large|main|further|see|etc|nil|unit|th|rd|nd|st)$"
        },
        {
          "type": "filter",
          "expr": "datum.count >= 36"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {"data": "words"},
      "encode": {
        "enter": {
          "text": {"field": "text"},
          "align": {
            "value": "center"
          },
          "baseline": {"value": "alphabetic"},
          "fill": {
            "signal": "indexof(['honour', 'memory', 'sacrifice'], datum.text) >= 0 ? '#b8281c' : indexof(['lest', 'forget', 'supreme', 'liveth', 'evermore'], datum.text) >= 0 ? '#2b2a27' : '#9b958a'"
          },
          "tooltip": {
            "signal": "{'Word': datum.text, 'Times used': datum.count}"
          }
        },
        "update": {
          "fillOpacity": {"value": 1}
        },
        "hover": {
          "fillOpacity": {"value": 0.6}
        }
      },
      "transform": [
        {
          "type": "wordcloud",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "text": {"field": "text"},
          "rotate": 0,
          "font": "Cormorant Garamond",
          "fontWeight": "700",
          "fontSize": {
            "field": "datum.count"
          },
          "fontSizeRange": [20, 86],
          "padding": 4
        }
      ]
    }
  ]
}
