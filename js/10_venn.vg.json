{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Venn diagram of the 1,399 Queensland war memorials: how many honour the First World War, the Second World War, both, or neither. The box holds every memorial. Circle areas are to scale: size = 60.957 x memorials (Vega size is the bounding-box area, so radius = sqrt(size) / 2, about 47.9 square pixels of circle per memorial). The centre distance (78.3 px, so x = 189.7 and 268.0) was solved so the overlap area matches the 429 memorials honouring both wars.",
  "width": 460,
  "height": 390,
  "padding": 1,
  "view": {"stroke": null},
  "layer": [
    {
      "data": {"url": "data/qld_memorials.csv"},
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "memorials"
            }
          ]
        },
        {
          "calculate": "'All Queensland memorials: ' + format(datum.memorials, ',')",
          "as": "title"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rect",
            "fill": "#fbf9f4",
            "stroke": "#756f62",
            "strokeWidth": 1,
            "cornerRadius": 4
          },
          "encoding": {
            "x": {"value": 1},
            "x2": {"value": 459},
            "y": {"value": 1},
            "y2": {"value": 388}
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "fontSize": 14,
            "fontWeight": 600,
            "color": "#4a473f",
            "x": 16,
            "y": 24
          },
          "encoding": {
            "text": {
              "field": "title",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {"url": "data/qld_memorials.csv"},
      "transform": [
        {
          "calculate": "indexof(datum.conflicts || '', 'First World War') >= 0 ? 1 : 0",
          "as": "First World War"
        },
        {
          "calculate": "indexof(datum.conflicts || '', 'Second World War') >= 0 ? 1 : 0",
          "as": "Second World War"
        },
        {
          "aggregate": [
            {"op": "sum", "field": "First World War", "as": "First World War"},
            {
              "op": "sum",
              "field": "Second World War",
              "as": "Second World War"
            }
          ]
        },
        {"fold": [ "First World War", "Second World War" ], "as": ["set", "total"]},
        {"calculate": "datum.total * 60.957", "as": "area"},
        {"calculate": "datum.set == 'First World War' ? 189.7 : 268.0", "as": "x"}
      ],
      "mark": {"type": "circle", "opacity": 0.55, "stroke": "#fbf9f4", "strokeWidth": 2},
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "scale": null,
          "axis": null
        },
        "size": {
          "field": "area",
          "type": "quantitative",
          "scale": null
        },
        "y": {"value": 200},
        "color": {
          "field": "set",
          "type": "nominal",
          "scale": {
            "domain": [
              "First World War",
              "Second World War"
            ],
            "range": ["#975b20", "#275267"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {"url": "data/qld_memorials.csv"},
      "transform": [
        {
          "calculate": "indexof(datum.conflicts || '', 'First World War') >= 0",
          "as": "w1"
        },
        {
          "calculate": "indexof(datum.conflicts || '', 'Second World War') >= 0",
          "as": "w2"
        },
        {
          "calculate": "datum.w1 && datum.w2 ? 'Both wars' : (datum.w1 ? 'Only WWI' : (datum.w2 ? 'Only WWII' : 'Neither world war'))",
          "as": "region"
        },
        {
          "aggregate": [
            {
              "op": "count",
              "as": "memorials"
            }
          ],
          "groupby": [
            "region"
          ]
        },
        {
          "calculate": "datum.region == 'Only WWI' ? 120 : (datum.region == 'Both wars' ? 230 : (datum.region == 'Only WWII' ? 340 : 230))",
          "as": "px"
        },
        {
          "calculate": "datum.region == 'Neither world war' ? 342 : 195",
          "as": "py"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "fontSize": 28,
            "fontWeight": 700,
            "font": "'Source Sans 3', sans-serif"
          },
          "encoding": {
            "x": {
              "field": "px",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "py",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "memorials",
              "type": "quantitative",
              "format": ","
            },
            "tooltip": [
              {
                "field": "region",
                "type": "nominal",
                "title": "Memorials honouring"
              },
              {
                "field": "memorials",
                "type": "quantitative",
                "title": "Count",
                "format": ","
              }
            ],
            "color": {
              "condition": {
                "test": "datum.region == 'Both wars'",
                "value": "#ffffff"
              },
              "value": "#2b2a27"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 14,
            "dy": 24
          },
          "encoding": {
            "x": {
              "field": "px",
              "type": "quantitative",
              "scale": null
            },
            "y": {
              "field": "py",
              "type": "quantitative",
              "scale": null
            },
            "text": {
              "field": "region",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "datum.region == 'Both wars'",
                "value": "#ffffff"
              },
              "value": "#2b2a27"
            }
          }
        }
      ]
    },
    {
      "data": {"url": "data/qld_memorials.csv"},
      "transform": [
        {
          "calculate": "indexof(datum.conflicts || '', 'First World War') >= 0 ? 1 : 0",
          "as": "First World War"
        },
        {
          "calculate": "indexof(datum.conflicts || '', 'Second World War') >= 0 ? 1 : 0",
          "as": "Second World War"
        },
        {
          "aggregate": [
            {"op": "sum", "field": "First World War", "as": "First World War"},
            {
              "op": "sum",
              "field": "Second World War",
              "as": "Second World War"
            }
          ]
        },
        {"fold": [ "First World War", "Second World War" ], "as": ["set", "total"]},
        {"calculate": "datum.set == 'First World War' ? 105 : 355", "as": "px"},
        {"calculate": "datum.set + ': ' + format(datum.total, ',')", "as": "title"}
      ],
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": 600,
        "color": "#2b2a27",
        "y": 54
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative",
          "scale": null
        },
        "text": {
          "field": "title",
          "type": "nominal"
        }
      }
    }
  ]
}
