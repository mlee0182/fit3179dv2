{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart. Each full square is 500 Australian deaths, coloured by conflict; a war's last square is filled only by its leftover share of 500, inside an outline of a full square. Source: Australian War Memorial.",
  "width": "container",
  "height": "container",
  "padding": {"top": 0, "left": 0, "right": 0, "bottom": 5},
  "config": {
    "view": {
      "stroke": null
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/awm_deaths_by_conflict.csv"
      },
      "transform": [
        {
          "calculate": "indexof(['First World War', 'Second World War', 'Boer War', 'Vietnam War', 'Korean War', 'Malayan Emergency'], datum.pop_conflict) >= 0 ? datum.pop_conflict : 'All other conflicts'",
          "as": "group"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "deaths",
              "as": "group_deaths"
            }
          ],
          "groupby": ["group"]
        },
        {
          "calculate": "indexof(['First World War', 'Second World War', 'Boer War', 'Vietnam War', 'Korean War', 'Malayan Emergency', 'All other conflicts'], datum.group)",
          "as": "order"
        },
        {
          "calculate": "datum.group + ': ' + format(datum.group_deaths, ',')",
          "as": "label"
        },
        {
          "calculate": "datum.group_deaths / 500",
          "as": "squares"
        },
        {
          "calculate": "sequence(ceil(datum.squares))",
          "as": "square_no"
        },
        {
          "flatten": ["square_no"]
        },
        {
          "calculate": "min(1, datum.squares - datum.square_no)",
          "as": "fill_share"
        },
        {
          "calculate": "'M-1,-1H' + (2 * datum.fill_share - 1) + 'V1H-1Z'",
          "as": "shape_path"
        },
        {
          "window": [
            {
              "op": "row_number",
              "as": "position"
            }
          ],
          "sort": [
            {
              "field": "order"
            },
            {
              "field": "square_no"
            }
          ]
        },
        {
          "calculate": "(datum.position - 1) % 24",
          "as": "col"
        },
        {
          "calculate": "floor((datum.position - 1) / 24)",
          "as": "row"
        }
      ],
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "tooltip": [
          {
            "field": "group",
            "type": "nominal",
            "title": "Conflict"
          },
          {
            "field": "group_deaths",
            "type": "quantitative",
            "title": "Australian deaths",
            "format": ","
          },
          {
            "field": "squares",
            "type": "quantitative",
            "title": "Squares (500 deaths each)",
            "format": ".2~f"
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "point",
            "filled": true,
            "opacity": 1,
            "size": {
              "expr": "pow(min(width / 24, height / 10) * 0.8, 2)"
            }
          },
          "encoding": {
            "shape": {
              "field": "shape_path",
              "type": "nominal",
              "scale": null
            },
            "color": {
              "field": "label",
              "type": "nominal",
              "sort": {
                "field": "order",
                "op": "min"
              },
              "scale": {
                "range": ["#975b20", "#275267", "#725e44", "#3e1875", "#2788b9", "#dba156", "#9b958a"]
              },
              "legend": {
                "title": "1 full square = 500 deaths",
                "orient": "bottom",
                "columns": 1,
                "symbolType": "square",
                "symbolSize": 140,
                "rowPadding": 4,
                "labelLimit": 260,
                "titleLimit": 240
              }
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.fill_share < 1"
            }
          ],
          "mark": {
            "type": "square",
            "filled": true,
            "fill": "transparent",
            "strokeWidth": 1,
            "size": {
              "expr": "pow(min(width / 24, height / 10) * 0.8, 2)"
            }
          },
          "encoding": {
            "stroke": {
              "field": "group",
              "type": "nominal",
              "scale": {
                "domain": ["First World War", "Second World War", "Boer War", "Vietnam War", "Korean War", "Malayan Emergency", "All other conflicts"],
                "range": ["#975b20", "#275267", "#725e44", "#3e1875", "#2788b9", "#dba156", "#9b958a"]
              },
              "legend": null
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "col": 0,
            "row": 9,
            "note": "Part-filled squares: fewer than 500 deaths"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -6,
        "fontSize": 14,
        "fontStyle": "italic",
        "color": "#4a473f"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal"
        },
        "y": {
          "field": "row",
          "type": "ordinal"
        },
        "text": {
          "field": "note",
          "type": "nominal"
        }
      }
    }
  ],
  "autosize": {
    "type": "fit",
    "contains": "padding"
  }
}
